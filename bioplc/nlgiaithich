const main=document.getElementById("main");
function selectRail(id){ rail.querySelectorAll(".stop").forEach(b=>b.setAttribute("aria-selected", b.id===id ? "true":"false")); }
function openIndex(focus){
  store.set("plc-session","0"); selectRail("tab-0");

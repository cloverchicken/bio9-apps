      h+=`<dt>${esc(H[j])}</dt><dd>${v}</dd>`;
    }
    h+=`</dl></article>`;
  });
  h+=`</div>`;
  sec.innerHTML=h;
  sec.querySelectorAll(".toolbar button").forEach(b=>b.addEventListener("click",()=>{
    const f=b.dataset.f; sec.querySelectorAll(".tm").forEach(c=>c.hidden = f!=="0" && c.dataset.k!==f);
  }));
}

{ const saved=store.get("plc-session"); const n=saved===null?0:+saved; if(n>0 && SESSIONS.some(s=>s.n===n&&!s.locked)) openSession(n,false); else openIndex(false); }
</script>

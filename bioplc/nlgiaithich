/* ---------- helpers ---------- */
const esc = s => String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const chips = h => h.replace(/KN([123])(?:\.[\dx])?(?:–KN\d\.\d)?/g, m => `<span class="kn k${m[2]}">${m}</span>`);
const inl = s => chips(esc(s));
function block(s){
  const lines = String(s||"").split("\n").map(l=>l.trim()).filter(Boolean);
  let out="", list=null;
  const close=()=>{ if(list){ out+=`</${list}>`; list=null; } };
  for(const l of lines){
    let m;
    if((m=l.match(/^[-–•]\s*(.*)$/))){ if(list!=="ul"){close(); out+="<ul>"; list="ul";} out+=`<li>${inl(m[1])}</li>`; }
    else if((m=l.match(/^\d+\.\s*(?:\[([^\]]+)\]\s*)?(.*)$/))){ if(list!=="ol"){close(); out+="<ol>"; list="ol";} out+=`<li>${m[1]?`<span class="qtag">${esc(m[1])}</span>`:""}${inl(m[2])}</li>`; }
    else { close(); out+=`<p>${inl(l)}</p>`; }
  }
  close(); return out;
}

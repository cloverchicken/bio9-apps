function openSession(n,focus){
  const s=SESSIONS.find(x=>x.n===n); if(!s||s.locked) return;
  store.set("plc-session",String(n));
  selectRail("tab-"+n);
  main.innerHTML=`<div class="s-head"><span class="meta">Buổi ${s.n} – ${s.wk} – ${PHASES[s.phase][0]}</span><h2>${esc(s.title)}</h2></div>
    <p class="goal"><b>Mục tiêu:</b> ${inl(s.goal)}</p><div class="tabs" role="tablist" aria-label="Nội dung buổi ${s.n}"></div>`;
  main.appendChild(document.getElementById("tpl-"+n).content.cloneNode(true));
  main.insertAdjacentHTML("beforeend",`<footer>Năng lực giải thích hiện tượng thực tiễn trong Sinh học – AY2627 PLC Trọng điểm 1.</footer>`);
  hydrate(n);
  const subs=[...main.querySelectorAll(".sub")], tabs=main.querySelector(".tabs");
  const key="plc-sub-"+n, saved=+store.get(key)||0;
  subs.forEach((sec,i)=>{
    const t=document.createElement("button"); t.type="button"; t.setAttribute("role","tab"); t.textContent=sec.dataset.label;
    t.addEventListener("click",()=>{ show(i); store.set(key,String(i)); });
    tabs.appendChild(t);
  });
  function show(i){ subs.forEach((s,j)=>s.classList.toggle("on",i===j)); [...tabs.children].forEach((t,j)=>t.setAttribute("aria-selected",i===j?"true":"false")); }
  show(saved<subs.length?saved:0);
  if(focus) document.getElementById("tab-"+n).scrollIntoView({block:"nearest",inline:"nearest"});
}

